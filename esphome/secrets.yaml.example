# Copy to esphome/secrets.yaml and fill in. (secrets.yaml is gitignored.)
# The ESPHome dashboard can generate the API encryption key for you
# (Install flow, or Settings), or paste one here.
wifi_ssid: "YOUR_WIFI"
wifi_password: "YOUR_WIFI_PASSWORD"
api_encryption_key: "GENERATE_IN_ESPHOME_DASHBOARD"
